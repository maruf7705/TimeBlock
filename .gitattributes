# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Configuration files
*.config.js text eol=lf
*.config.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Android specific
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf
gradlew text eol=lf
*.java text eol=lf
*.kt text eol=lf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Archives
*.7z binary
*.jar binary
*.rar binary
*.apk binary
*.aab binary

# GitHub Linguist overrides (for accurate language detection)
# Exclude specific directories from language statistics
dist/** linguist-generated=true
build/** linguist-generated=true
android/app/build/** linguist-generated=true
node_modules/** linguist-vendored=true
*.lock linguist-generated=true

# Mark Android XML as not being the primary language
android/** linguist-vendored=true

# Ensure JavaScript/TypeScript is detected properly
*.js linguist-detectable=true
*.jsx linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
